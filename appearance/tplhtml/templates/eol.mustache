{{!
    @template lessonappearance_tplhtml/eol

    HTML Template lesson appearance - end of lesson results page.

    Renders the processed HTML template with optional custom CSS.

    Example context (json):
    {
        "processedhtml": "<div class='my-eol'>...</div>",
        "customcss": ".my-eol { color: green; }",
        "hascss": true
    }
}}

{{#hascss}}
<style>{{{customcss}}}</style>
{{/hascss}}
<div class="lessonappearance-tplhtml lessonappearance-tplhtml-eol">
    {{{processedhtml}}}
</div>
