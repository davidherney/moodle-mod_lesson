{{!
    @template lessonappearance_scene/eol

    Scene lesson appearance template for the end-of-lesson results page.

    Renders the congratulations/results page with the scene design.

    Example context (json):
    {
        "congratulations": "Congratulations - end of lesson reached",
        "hascongratulations": true,
        "messages": [{"text": "Your score is 80 out of 100."}],
        "hasmessages": true,
        "navigation_buttons": "<a href='#'>Return to course</a>",
        "progress_bar": "<div class='progress'>100%</div>",
        "hasbackground": true,
        "background_url": "http://example.com/bg.png",
        "hascharacter": true,
        "character_url": "http://example.com/char.png",
        "hasflag": true,
        "flag_url": "http://example.com/flag.png",
        "hasgood": true,
        "good_url": "http://example.com/good.png",
        "color_primary": "#3a5a8c",
        "color_secondary": "#6c757d",
        "color_good": "#28a745",
        "color_bad": "#dc3545",
        "color_default": "#333333"
    }
}}

<div id="id_scenecontainer" class="lessonappearance-scene lessonappearance-scene-eol"
     style="
        --scene-color-primary: {{color_primary}};
        --scene-color-secondary: {{color_secondary}};
        --scene-color-good: {{color_good}};
        --scene-color-bad: {{color_bad}};
        --scene-color-default: {{color_default}};
     "
>
    {{#hasbackground}}
    <div class="scene-background" style="background-image: url('{{background_url}}');"></div>
    {{/hasbackground}}

    <div class="scene-overlay">
        <div class="scene-progress">
            {{{progress_bar}}}
        </div>

        <div class="scene-top">
            {{#hascharacter}}
            <div class="scene-character">
                <img src="{{character_url}}" alt="" role="presentation" />
            </div>
            {{/hascharacter}}

            <div class="scene-balloon">
                {{#hascongratulations}}
                <div class="scene-balloon-title">
                    <h3>{{congratulations}}</h3>
                </div>
                {{/hascongratulations}}
                <div class="scene-balloon-content no-overflow">
                    {{#messages}}
                    <p class="text-center">{{{text}}}</p>
                    {{/messages}}
                </div>
            </div>

            {{#hasflag}}
            <div class="scene-flag">
                <img src="{{flag_url}}" alt="" role="presentation" />
            </div>
            {{/hasflag}}
        </div>

        {{#hasgood}}
        <div class="scene-feedback scene-good">
            <img src="{{good_url}}" alt="" role="presentation" />
        </div>
        {{/hasgood}}

        <div class="scene-navigation">
            {{{navigation_buttons}}}
        </div>
    </div>
</div>
